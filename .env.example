# ============================================================
# Plantilla de variables de entorno (copiar a web/.env)
# Nunca subas el archivo .env real: contiene claves y secretos.
# ============================================================

# ---------- Aplicación ----------
APP_NAME="Control de peaje"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://peaje.tudominio.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

# ---------- Base de datos (MySQL del hosting) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------- Colas y sesiones (hosting compartido: sin workers) ----------
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ---------- Acceso (lista blanca: tabla usuarios) ----------
# Google OAuth 2.0: crear en Google Cloud Console (pasos en docs/google-oauth.md).
# URI de redirección autorizada en Google: https://TU-SUBDOMINIO/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Otros Client ID aceptados en POST /api/v1/auth/google (ej. el de Android), separados por coma.
GOOGLE_CLIENT_IDS_EXTRA=
# true = también se puede entrar con correo y contraseña. La guía pide solo Google: false en producción.
LOGIN_CON_CONTRASENA=true

# Administradores iniciales (separados por coma). El docente ya se carga por seeder.
ADMIN_EMAILS=
# Contraseña inicial de esas cuentas (solo si LOGIN_CON_CONTRASENA=true).
# Vacía = el seeder genera una por cuenta y la muestra en consola.
ADMIN_PASSWORD=

# Clave de la app móvil (no tiene login). Va también al compilar el APK: --dart-define=API_KEY=...
# Genera una con: php -r "echo bin2hex(random_bytes(24));"
MOVIL_API_KEY=

# ---------- Pusher (tiempo real) ----------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Variables que lee el frontend (Vite). No cambies los nombres.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------- Inferencia ----------
# http (producción, lo que pide el lab): endpoint de Colab o RunPod. Lo levanta
#        inferencia/peaje_colab.ipynb, que al final imprime INFERENCE_URL e INFERENCE_TOKEN.
#        La URL cambia cada vez que se reinicia el notebook: actualízala y ejecuta php artisan config:clear.
# local: modelos ONNX dentro de PHP (solo para desarrollo en la PC; necesita FFI).
INFERENCE_DRIVER=http
INFERENCE_URL=
INFERENCE_TOKEN=
INFERENCE_TIMEOUT=60
CONFIANZA_MINIMA_OCR=0.6
# Lecturas SIN formato boliviano se registran solo con OCR por encima de esto (placas extranjeras).
CONFIANZA_SIN_FORMATO=0.9
# Frames que la caseta web envía a la vez (video y cámara). 3 en el hosting; 1 en la PC.
FRAMES_EN_PARALELO=3

# Driver local. auto = FFI en la petición si se puede; si no, un proceso de consola PHP.
INFERENCE_LOCAL_MODO=auto
# Solo desarrollo o VPS: URL de "php artisan peaje:servidor-inferencia" (modelos en memoria, 2-3 veces más rápido).
# En hosting compartido o en producción déjala vacía (no se permite localhost).
INFERENCE_LOCAL_SERVIDOR=
# PHP de consola para el modo cli (en cPanel: /usr/local/bin/php o /opt/alt/php82/usr/bin/php).
INFERENCE_PHP_CLI=
# Argumentos extra para ese PHP (ej. en tu PC con XAMPP: -d extension=ffi)
INFERENCE_PHP_CLI_ARGS=
# Vacío = modelos/onnxruntime/<plataforma>/ (o ejecuta: php artisan peaje:instalar-onnx)
ONNXRUNTIME_LIB=
INFERENCE_HILOS=2
INFERENCE_LLANTAS=true
INFERENCE_LADO_MAXIMO=1280

# Segundos en que la misma placa en la misma caseta no se cobra de nuevo (video con muchos frames).
VENTANA_DUPLICADO=60


# ---------- Agente conversacional ----------
# Qwen con Ollama en el mismo Colab de la inferencia (mismo link y token): no necesita otra clave.
# El modelo se elige en la celda 1 del notebook (AGENTE_MODELO). Segundos máximos por respuesta:
AGENTE_TIMEOUT=60

# ---------- Correo (no se usa en la versión actual) ----------
MAIL_MAILER=log
